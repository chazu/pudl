package rules

// Argo CD graph edges, read by `pudl graph export` and the web explorer.
// Targets are resource_ids from the joins in argocd_pack.cue. basis is
// "observed": every edge is read from collected records.

// An Application or ApplicationSet lives in the cluster Argo CD runs in,
// the cluster its record was collected from.
argocd_graph_app_cluster: {
	head: {rel: "graph_edge", args: {type: "in_cluster", source: "$R", target: "$C", basis: "observed"}}
	body: [
		{rel: "argocd_app", args: {resource_id: "$R", cluster: "$H"}},
		{rel: "argocd_cluster", args: {resource_id: "$C", host: "$H"}},
	]
}
argocd_graph_appset_cluster: {
	head: {rel: "graph_edge", args: {type: "in_cluster", source: "$R", target: "$C", basis: "observed"}}
	body: [
		{rel: "argocd_appset", args: {resource_id: "$R", cluster: "$H"}},
		{rel: "argocd_cluster", args: {resource_id: "$C", host: "$H"}},
	]
}

// An Application generated from an ApplicationSet's template: the
// Application's owner reference names the ApplicationSet's UID.
argocd_graph_generated_by: {
	head: {rel: "graph_edge", args: {type: "generated_by", source: "$R", target: "$S", basis: "observed"}}
	body: [
		{rel: "argocd_app_owner", args: {resource_id: "$R", kind: "ApplicationSet", uid: "$U"}},
		{rel: "argocd_appset", args: {resource_id: "$S", uid: "$U"}},
	]
}

// An Application deploys to the cluster its destination names.
argocd_graph_deploys_to: {
	head: {rel: "graph_edge", args: {type: "deploys_to", source: "$R", target: "$C", basis: "observed"}}
	body: [
		{rel: "argocd_app_target_host", args: {resource_id: "$R", host: "$H"}},
		{rel: "argocd_cluster", args: {resource_id: "$C", host: "$H"}},
	]
}

// A workload is deployed by the Application that lists it among its
// managed resources in the workload's cluster.
argocd_graph_deployed_by: {
	head: {rel: "graph_edge", args: {type: "deployed_by", source: "$W", target: "$A", basis: "observed"}}
	body: [{rel: "argocd_workload_app", args: {workload: "$W", application: "$A"}}]
}

// sourced_from is declared but no rule derives it yet: a repository path
// has no node in pudl (docs/design/2026-11-13-argocd-pack.md, decision 7).
_argocdEdgeTypes: {
	generated_by: {category: "containment", label: "generated by", meaning: "Generated from this ApplicationSet's template."}
	deploys_to: {category: "dependency", label: "deploys to", meaning: "Sync creates this application's objects in this cluster."}
	deployed_by: {category: "dependency", label: "deployed by", meaning: "Argo CD lists this object among the application's managed resources."}
	sourced_from: {category: "dependency", label: "sourced from", meaning: "Manifests come from this repository path at the target revision."}
}

for id, e in _argocdEdgeTypes {
	"graph_edge_type_\(id)": {head: {rel: "graph_edge_type", args: {type: id, category: e.category, label: e.label, meaning: e.meaning}}}
}
